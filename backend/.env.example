# Server
PORT=3000                                    # optional, default 3000

# --- MongoDB --- optional at boot; without it the server still starts and
# responds on /health, but any route/script touching a Mongoose model
# (ticket sync/categorize/list, reports, Jira KB sync/search) returns a
# 503 "feature disabled" (routes) or a clear CLI error (scripts) instead of crashing.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-rca

# --- Jira (ticket categorization pipeline) --- required only when you run
# ticket sync (npm run sync-tickets / POST /api/tickets/sync); the server
# boots fine without these, those specific calls just fail until set.
JIRA_BASE_URL=https://your-domain.atlassian.net       # your Jira Cloud site URL
JIRA_EMAIL=you@example.com                            # Jira account email for the API token below
JIRA_API_TOKEN=your-jira-api-token                    # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_DEFAULT_JQL=project = SUPPORT AND component = "Supplier" AND created >= -90d   # optional, has a built-in default

# --- Claude API --- required only when you run categorization
# (npm run categorize-tickets / POST /api/tickets/categorize).
ANTHROPIC_API_KEY=your-anthropic-api-key              # https://console.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5-20251001             # optional, has a built-in default

# --- New Relic --- fully optional. Unset = app boots with a warning and no
# APM instrumentation. Also requires `npm install newrelic` once you set this
# (see src/config/newrelic.ts for why it's not a default dependency).
NEW_RELIC_LICENSE_KEY=                                # optional - unset disables New Relic entirely
NEW_RELIC_APP_NAME=smart-rca-backend                  # optional, only used if NEW_RELIC_LICENSE_KEY is set

# --- Camunda --- fully optional. Unset = app boots with a warning and
# isCamundaEnabled() reports false everywhere.
CAMUNDA_BASE_URL=                                     # optional - e.g. https://camunda.internal.example.com/engine-rest
CAMUNDA_AUTH_USERNAME=                                # optional, only used if CAMUNDA_BASE_URL is set
CAMUNDA_AUTH_PASSWORD=                                # optional, only used if CAMUNDA_BASE_URL is set

# --- Jira Knowledge-Base sync (npm run sync:jira-kb) --- required only for
# that sync; MONGODB_URI above must also be set. None of these are hardcoded
# in code - this is the one place they're configured.
#
# Confirmed against GEP's actual Jira (smartbygep.atlassian.net): "Supplier
# Profile" is NOT a standard component or label on any real ticket - it's a
# value of a custom single-select field called "Actionable-Team"
# (customfield_15279, referenced in JQL as cf[15279]), and it's only meaningful
# within the PLS project ("Project-LEO-Supplier") - the same field on tickets
# in other projects (e.g. the shared INC incident queue) holds unrelated team
# names. If your Jira genuinely uses a real `component` field for this,
# JIRA_KB_MATCH_FIELD's default ("component") still works unchanged.
JIRA_KB_PROJECT_KEY=PLS                                                       # your Jira project key
JIRA_KB_MATCH_FIELD=cf[15279]                                                 # JQL field reference; "component" (default), "labels", or cf[<id>] for a custom field
JIRA_KB_COMPONENT=Supplier Profile                                            # value to match JIRA_KB_MATCH_FIELD against
JIRA_KB_ASSIGNEES=Swapnil Supekar,Ankit Yadav,Tajes Satpute,Saquib Shaikh,Priyanka Davle   # comma-separated display names, resolved to accountIds at sync time
JIRA_KB_COLLECTION=jira_kb_chunks                                             # optional, Mongo collection name for KB chunks
JIRA_KB_VECTOR_INDEX=jira_kb_vector_index                                     # optional, must match the Atlas Vector Search index name (see README)
JIRA_KB_CHUNK_SIZE=1500                                                       # optional, max characters per embedded chunk

# --- Embeddings (used by the Jira KB sync + search) --- pick one provider.
# Anthropic has no first-party embeddings API; Voyage AI is Anthropic's
# recommended embedding partner, so it's the default. OpenAI is a drop-in
# alternative behind the same interface (src/services/embeddingProvider.ts).
EMBEDDING_PROVIDER=voyage                             # optional, "voyage" (default) or "openai"
VOYAGE_API_KEY=your-voyage-api-key                    # required if EMBEDDING_PROVIDER=voyage - https://dash.voyageai.com
VOYAGE_EMBEDDING_MODEL=voyage-3                       # optional, has a built-in default
OPENAI_API_KEY=your-openai-api-key                    # required if EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small         # optional, has a built-in default
