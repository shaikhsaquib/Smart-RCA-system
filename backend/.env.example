# Server
PORT=3000

# MongoDB Atlas free tier (M0 cluster) connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-rca

# Jira (read-only API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_DEFAULT_JQL=project = SUPPORT AND component = "Supplier" AND created >= -90d

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
