{
  "name": "rca-assistant",
  "version": "1.0.0",
  "description": "Agentic RCA triage assistant for the Supplier module - orchestrator + diagnostic stage agents mirroring the manual production-support triage sequence",
  "main": "dist/orchestrator/orchestrator.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "rca": "ts-node src/cli/run.ts",
    "rca:all-fixtures": "ts-node src/cli/run.ts --all-fixtures",
    "stage:build-portal": "ts-node src/cli/run-stage.ts buildPortal",
    "stage:mongo": "ts-node src/cli/run-stage.ts mongo",
    "stage:camunda": "ts-node src/cli/run-stage.ts camunda",
    "stage:new-relic": "ts-node src/cli/run-stage.ts newRelic",
    "stage:code-debug": "ts-node src/cli/run-stage.ts codeDebug",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts'"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
