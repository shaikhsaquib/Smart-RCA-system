# Every value below is optional. Any stage whose required variables are missing
# runs in MOCK MODE (deterministic, clearly-labeled fake evidence) instead of
# failing, so the orchestrator's control flow can be tested end-to-end before
# any real credentials are wired in. Wire these in one integration at a time.

# --- Build Portal (Config-Check stage) ---
# No confirmed API exists yet (per FSD). If/when one does, set this and update
# src/stages/buildPortalStage.ts to call it instead of reading a local snapshot file.
BUILD_PORTAL_API_URL=
BUILD_PORTAL_API_KEY=
# Path to a manually-exported config snapshot (JSON) to check against instead.
BUILD_PORTAL_CONFIG_SNAPSHOT_PATH=

# --- MongoDB (Data-Check stage) ---
# Read-only credentials into the Supplier module's operational database (NOT the
# ticket-categorization store in ../backend - this is a separate database).
RCA_MONGODB_URI=
RCA_MONGODB_DB_NAME=supplier_platform
RCA_MONGODB_SUPPLIER_COLLECTION=suppliers

# --- Camunda (Workflow Log-Check stage) ---
CAMUNDA_BASE_URL=
CAMUNDA_AUTH_USERNAME=
CAMUNDA_AUTH_PASSWORD=
CAMUNDA_PROCESS_DEFINITION_KEY=supplier-onboarding

# --- New Relic (APM Log-Check stage) ---
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_APP_NAME=supplier-service

# --- Code-Debug stage ---
# Absolute path to the checked-out service codebase to grep through.
CODE_DEBUG_ROOT_PATH=
